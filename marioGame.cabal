cabal-version: 3.12

name:          mario-game
version:       0.1.0.0
synopsis:      Super Mario Bros. clone in Haskell
license:       MIT
author:        Ayman Hassen, Jake Alsept
build-type:    Simple

data-files:
    assets/*.png
  , assets/*.mp3

executable mario
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:
      Constants
    , Enemy
    , Fireball
    , GameState
    , Level
    , Mario
    , Music
    , Physics
    , PowerUp
    , Rendering
    , Types
  build-depends:
      base
    , gloss
    , gloss-juicy
    , process
    , unix
  default-language: Haskell2010